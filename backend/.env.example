# Copy this file to backend/.env and fill in your real key before running.
# Get a free key at https://aistudio.google.com/apikey — no card required for
# the free tier (gemini-3.6-flash).

GEMINI_API_KEY=your-key-here
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Set APP_ENV=production and list the exact frontend origins when deploying.
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Ollama server base URL. The /api/chat endpoint is added automatically.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Ollama model used for local agent requests.
OLLAMA_MODEL=llama3.2:latest

# Leave unset for the local SQLite database at backend/agent_forge.db.
# Team deployment should configure a PostgreSQL URL through the deployment's
# secret environment, e.g. postgresql+psycopg://<user>:<password>@<host>:5432/<database>.
# Do not put production credentials in this file or commit them to Git.
# DATABASE_URL=
